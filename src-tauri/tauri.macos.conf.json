{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.agentchat.app",
  "app": {
    "windows": [
      {
        "title": "AgentChat",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 28
        }
      }
    ]
  },
  "build": {
    "beforeDevCommand": "bun run --cwd runner build && vpr dev",
    "beforeBuildCommand": "bun run build"
  },
  "bundle": {
    "resources": {
      "../runner/dist/entry.js": "runner/entry.js"
    }
  }
}
