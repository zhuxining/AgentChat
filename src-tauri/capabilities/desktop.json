{
  "identifier": "desktop-capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "autostart:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "cli:default",
    "opener:default",
    "clipboard-manager:default",
    "dialog:default",
    "fs:default",
    "global-shortcut:default",
    "notification:default",
    "os:default",
    "process:default",
    "stronghold:default",
    "updater:default",
    "window-state:default"
  ]
}
